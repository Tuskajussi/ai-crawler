# Copy to .env for Docker Compose, or /etc/crawlspace/crawlspace.env for systemd.
# Replace the domain and registration secret before starting production.
# Keep this file private; never prefix secrets with VITE_.
NODE_ENV=production
CRAWLSPACE_PUBLIC_URL=https://crawl.example.com
CRAWLSPACE_HOST=127.0.0.1
CRAWLSPACE_PORT=3001
CRAWLSPACE_DATA_DIR=/var/lib/crawlspace
# Generate with: openssl rand -hex 32
# An empty secret closes registration. Existing accounts can still log in.
CRAWLSPACE_REGISTRATION_SECRET=
# For the systemd + Nginx layout only. Compose overrides this to false.
CRAWLSPACE_TRUST_PROXY=loopback
# Shared, operator-managed model credentials and approved endpoint origins.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
CRAWLSPACE_MODEL_KEY_ALLOWLIST=ANTHROPIC_API_KEY,OPENAI_API_KEY
# Optional additional local/Ollama or compatible API origins. No paths or trailing slash.
# CRAWLSPACE_MODEL_ENDPOINT_ORIGINS=http://127.0.0.1:11434
# Optional screenshot preview origins; explicit loopback URLs only, including ports.
# CRAWLSPACE_PREVIEW_ORIGINS=http://127.0.0.1:4173


{
  "name": "crawlspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --import tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "test": "tsx --test server/*.test.ts",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "test:pi": "tsx scripts/pi-smoke.ts",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "setup": "node scripts/setup.mjs",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@xyflow/react": "^12.10.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
